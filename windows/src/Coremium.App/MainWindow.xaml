<Window x:Class="Coremium.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coremium (beta)" Width="1080" Height="700" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource UI}"
        WindowStartupLocation="CenterScreen" Icon="app.ico" UseLayoutRounding="True">
  <Grid Margin="28,22,28,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- chip panel -->
    <StackPanel Grid.Column="0" Margin="0,4,28,0">
      <Grid Width="160" Height="160" HorizontalAlignment="Left">
        <UniformGrid Rows="1" Columns="9" Height="8" VerticalAlignment="Top" Margin="26,0">
          <UniformGrid.Resources><Style TargetType="Rectangle"><Setter Property="Fill" Value="#3CFFFFFF"/><Setter Property="Width" Value="5"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style></UniformGrid.Resources>
          <Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/>
        </UniformGrid>
        <UniformGrid Rows="1" Columns="9" Height="8" VerticalAlignment="Bottom" Margin="26,0">
          <UniformGrid.Resources><Style TargetType="Rectangle"><Setter Property="Fill" Value="#3CFFFFFF"/><Setter Property="Width" Value="5"/></Style></UniformGrid.Resources>
          <Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/>
        </UniformGrid>
        <UniformGrid Rows="9" Columns="1" Width="8" HorizontalAlignment="Left" Margin="0,26">
          <UniformGrid.Resources><Style TargetType="Rectangle"><Setter Property="Fill" Value="#3CFFFFFF"/><Setter Property="Height" Value="5"/></Style></UniformGrid.Resources>
          <Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/>
        </UniformGrid>
        <UniformGrid Rows="9" Columns="1" Width="8" HorizontalAlignment="Right" Margin="0,26">
          <UniformGrid.Resources><Style TargetType="Rectangle"><Setter Property="Fill" Value="#3CFFFFFF"/><Setter Property="Height" Value="5"/></Style></UniformGrid.Resources>
          <Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/><Rectangle/>
        </UniformGrid>
        <Border Margin="12" CornerRadius="24" BorderBrush="#55FFFFFF" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5C5C5C" Offset="0"/><GradientStop Color="#262626" Offset="0.55"/><GradientStop Color="#444" Offset="1"/></LinearGradientBrush>
          </Border.Background>
          <Border Margin="18" CornerRadius="14" Background="#99000000">
            <Image Source="app.ico" Width="54" Height="54" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
        </Border>
      </Grid>
      <TextBlock Text="{Binding ChipName}" Margin="0,18,0,0" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding CoresText}" Margin="0,6,0,0" Foreground="{StaticResource Dim}" FontSize="13" TextWrapping="Wrap"/>
      <Grid Margin="0,18,0,0" Height="8">
        <Border CornerRadius="4" Background="#1AFFFFFF"/>
        <Border x:Name="LoadBar" CornerRadius="4" Background="{StaticResource Yield}" HorizontalAlignment="Left" Width="0"/>
      </Grid>
      <TextBlock Text="{Binding LoadText}" Margin="0,6,0,0" Foreground="{StaticResource Dim}" FontSize="12.5"/>
      <TextBlock Text="{Binding MemoryText}" Margin="0,14,0,0" FontSize="13.5"/>
      <TextBlock Text="{Binding PowerText}" Margin="0,6,0,0" FontSize="13.5"/>
      <Border Margin="0,26,0,0" CornerRadius="10" Background="#14FFFFFF" Padding="12,10">
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Dim}"
                   Text="Beta for Windows 10 and 11. Moved apps run in Windows efficiency mode (the same as Task Manager's), and go back when you leave, pause or quit."/>
      </Border>
    </StackPanel>

    <!-- main -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <ItemsControl Grid.Row="0" ItemsSource="{Binding Modes}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Title}" Tag="{Binding Mode}" Click="Mode_Click" ToolTip="{Binding Title}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Pill}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Selected}" Value="True">
                      <Setter Property="Background" Value="{StaticResource Perf}"/><Setter Property="Foreground" Value="Black"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Grid.Row="1" Margin="2,10,0,0">
        <TextBlock Text="{Binding Status}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" MaxHeight="40">
          <Run Text="{Binding DecisionHead, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{Binding DecisionDetail, Mode=OneWay}" Foreground="{StaticResource Dim}"/>
        </TextBlock>
        <TextBlock Text="{Binding Warning}" Margin="0,4,0,0" FontSize="12.5" Foreground="#F5D25B">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Warning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </StackPanel>

      <DockPanel Grid.Row="2" Margin="0,16,0,8" LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="Running apps" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" x:Name="PauseButton" Style="{StaticResource Pill}" Margin="6,0,0,0" Click="Pause_Click" Content="Pause"/>
        <Button DockPanel.Dock="Right" x:Name="StorageButton" Style="{StaticResource Pill}" Margin="6,0,0,0" Click="Storage_Click" Content="Storage"
                ToolTip="See temporary files, browser caches and old downloads, and move them to the Recycle Bin."/>
        <Button DockPanel.Dock="Right" x:Name="AdvancedButton" Style="{StaticResource Pill}" Margin="6,0,0,0" Click="Advanced_Click" Content="# Advanced"
                ToolTip="Show the numbers: CPU %, process counts and why each rule applies."/>
      </DockPanel>

      <Grid Grid.Row="3" x:Name="StorageView" Visibility="Collapsed" DataContext="{Binding Storage}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Summary}" FontSize="13.5" FontWeight="SemiBold" Margin="2,0,0,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="10" Background="{StaticResource Card}" Margin="0,0,0,4" Padding="12,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Kind}" FontSize="11.5" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="True">
          <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="White" Foreground="Black" Margin="6,0,0,0"
                  Content="{Binding SelectedText}" Click="StorageReview_Click"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="6,0,0,0" Content="Scan" Click="StorageScan_Click"/>
          <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
      </Grid>

      <ScrollViewer Grid.Row="3" x:Name="AppsView" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="12" Background="{StaticResource Card}" Margin="0,0,0,5" Padding="12,9">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Numbers}" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Faint}">
                      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Numbers}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Load}" VerticalAlignment="Center" Margin="10,0,14,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Dim}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Moved}" Value="True"><Setter Property="Foreground" Value="{StaticResource Mint}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <ItemsControl Grid.Column="3" ItemsSource="{Binding Chips}" VerticalAlignment="Center" Tag="{Binding Id}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding Label}" Click="Chip_Click" Margin="3,0,0,0" Padding="10,4" FontSize="12"
                                Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Pill}">
                              <Setter Property="Margin" Value="3,0,0,0"/>
                              <Setter Property="Foreground" Value="#80FFFFFF"/>
                              <Setter Property="Background" Value="#12FFFFFF"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="implied"><Setter Property="BorderBrush" Value="#B0FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="White"/></DataTrigger>
                                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="chosen"/><Condition Binding="{Binding Label}" Value="Boost"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="{StaticResource Boost}"/><Setter Property="Foreground" Value="Black"/></MultiDataTrigger>
                                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="chosen"/><Condition Binding="{Binding Label}" Value="Normal"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#C8C8C8"/><Setter Property="Foreground" Value="Black"/></MultiDataTrigger>
                                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="chosen"/><Condition Binding="{Binding Label}" Value="Yield"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="{StaticResource Yield}"/><Setter Property="Foreground" Value="Black"/></MultiDataTrigger>
                                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="chosen"/><Condition Binding="{Binding Label}" Value="Eco"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="{StaticResource Mint}"/><Setter Property="Foreground" Value="Black"/></MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="4" Margin="0,10,0,0" CornerRadius="14" Background="{StaticResource Card}" Padding="16,11">
        <StackPanel>
          <TextBlock Text="{Binding TodayText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding NowText}" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
